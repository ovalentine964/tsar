# ============================================================
# TSAR — Environment Configuration Template
# ============================================================
# Copy to .env and fill in your values:
#   cp .env.template .env
#
# Variables marked [REQUIRED] must be set before deployment.
# Variables marked [OPTIONAL] have sensible defaults.
# ============================================================


# ── BINANCE (Required for trading) ───────────────────────────
# Testnet: https://testnet.binance.vision → Generate API Key
# Live:    https://www.binance.com → API Management
EXCHANGE_API_KEY=                       # [REQUIRED] Binance API key
EXCHANGE_SECRET=                        # [REQUIRED] Binance API secret
EXCHANGE_SANDBOX=true                   # [OPTIONAL] true = testnet (safe), false = real money


# ── TSAR API Security [REQUIRED] ────────────────────────────
# SECURITY: Generate a strong key. TSAR refuses to start without one.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TSAR_API_KEY=                           # REQUIRED — API authentication key (min 16 chars)
TSAR_API_PORT=8000                      # [OPTIONAL] API server port (default: 8000)
TSAR_TRADING_MODE=paper                 # [OPTIONAL] paper = safe testing, live = real money


# ── REDIS [REQUIRED] ────────────────────────────────────────
# SECURITY: Generate a strong password.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_HOST=redis                        # Redis hostname ('redis' for Docker, 'localhost' for local)
REDIS_PORT=6379                         # Redis port
REDIS_PASSWORD=                         # REQUIRED — Redis authentication password


# ── CORS [REQUIRED for web/mobile access] ───────────────────
# Comma-separated list of allowed origins.
# Example: https://tsar-app.eastus.azurecontainer.io,https://yourdomain.com
# Leave empty to deny all cross-origin requests.
TSAR_CORS_ORIGINS=                      # REQUIRED — allowed CORS origins


# ── NVIDIA AI (Required for LLM features) ───────────────────
# Free key: https://build.nvidia.com → Get API Key
NVIDIA_API_KEY=                         # REQUIRED — NVIDIA NIM API key


# ── TELEGRAM (Optional — phone alerts) ──────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy token
# 2. Message your bot → visit api.telegram.org/bot<TOKEN>/getUpdates → copy chat_id
TELEGRAM_BOT_TOKEN=                     # [OPTIONAL] Telegram bot token
TELEGRAM_CHAT_ID=                       # [OPTIONAL] Your Telegram chat ID


# ── LLM PROVIDERS (Optional — enhanced with cloud models) ──
# DeepSeek: https://platform.deepseek.com
DEEPSEEK_API_KEY=                       # [OPTIONAL] DeepSeek cloud reasoning

# Ollama runs locally — no key needed (http://localhost:11434)


# ── DEFI (Optional — on-chain trading) ──────────────────────
# Master key for encrypting DeFi wallet private keys.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TSAR_WALLET_MASTER_KEY=                 # [OPTIONAL] DeFi wallet encryption key


# ── TLS (Optional — HTTPS) ──────────────────────────────────
# Self-signed: ./deploy/tls/generate-self-signed.sh
# Or provide paths to your own CA-signed cert/key
TSAR_SSL_CERTFILE=                      # [OPTIONAL] TLS certificate file path
TSAR_SSL_KEYFILE=                       # [OPTIONAL] TLS private key file path


# ── Monitoring (Grafana) ────────────────────────────────────
# Required when using: docker compose --profile monitoring
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
GRAFANA_ADMIN_PASSWORD=                 # [OPTIONAL] Grafana admin password


# ── Azure Deployment (used by scripts/deploy-azure.sh) ──────
# [OPTIONAL] Docker image tag to deploy. Default: latest.
TSAR_IMAGE_TAG=latest

# [OPTIONAL] Azure Container Registry (ACR) credentials.
# If set, the script pulls from ACR instead of local build.
TSAR_ACR_SERVER=                        # e.g., tsarregistry.azurecr.io
TSAR_ACR_USERNAME=                      # ACR username
TSAR_ACR_PASSWORD=                      # ACR password or service principal

# ============================================================
# TSAR — Render.com Environment Variables Template
# ============================================================
# Copy these into Render Dashboard → Environment → Env Vars
# Or use: render blueprint deploy (reads render.yaml)
#
# ⚠️  FILLED VALUES below are safe defaults for paper trading.
#     Placeholders (YOUR_...) MUST be replaced before deploy.
# ============================================================


# ══════════════════════════════════════════════════════════════
# REQUIRED — Replace placeholders before deploying
# ══════════════════════════════════════════════════════════════

# Binance API — get from https://testnet.binance.vision (paper) or binance.com (live)
EXCHANGE_API_KEY=YOUR_BINANCE_API_KEY
EXCHANGE_SECRET=YOUR_BINANCE_API_SECRET

# NVIDIA NIM — free key from https://build.nvidia.com
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY

# TSAR API Key — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TSAR_API_KEY=YOUR_GENERATED_API_KEY


# ══════════════════════════════════════════════════════════════
# CORE — Safe defaults for $10 paper trading
# ══════════════════════════════════════════════════════════════

TSAR_ENVIRONMENT=production
TSAR_TRADING_MODE=paper
TSAR_API_PORT=8000
PYTHONUNBUFFERED=1
TSAR_DATABASE_BACKEND=sqlite
TSAR_DATABASE_PATH=/app/data/tsar.db

# Exchange safety — testnet by default
EXCHANGE_SANDBOX=true


# ══════════════════════════════════════════════════════════════
# STRATEGY — VMPM (Valentine Money Printing Machine)
# ══════════════════════════════════════════════════════════════

STRATEGY=vmpm
VMPM_STATUS=ACTIVE

# ── Pipeline Thresholds ──────────────────────────────────────
VMPM_MIN_SIGNAL_SCORE=0.70        # Minimum pipeline score for entry (0-1)
VMPM_MIN_CONFLUENCE_SCORE=55.0    # Minimum confluence score (0-100)
VMPM_MIN_RISK_REWARD=2.5          # Minimum R:R ratio for execution

# ── Moving Averages ──────────────────────────────────────────
VMPM_MA_FAST_PERIOD=50            # Fast SMA period
VMPM_MA_SLOW_PERIOD=200           # Slow SMA period
VMPM_MA_TYPE=SMA                  # SMA or EMA

# ── RSI ──────────────────────────────────────────────────────
VMPM_RSI_PERIOD=14
VMPM_RSI_OVERSOLD=30              # Long entry threshold
VMPM_RSI_OVERBOUGHT=70            # Short entry threshold

# ── Support/Resistance & Retest ──────────────────────────────
VMPM_SR_PROXIMITY_PCT=0.3         # Price must be within 0.3% of S/R
VMPM_RETEST_CANDLES=3             # Candles for retest confirmation
VMPM_ATR_BUFFER_MULT=0.5          # ATR buffer for stop loss placement

# ── Exit Parameters ──────────────────────────────────────────
VMPM_STOP_LOSS_ATR_MULT=1.5       # Stop loss = 1.5 × ATR
VMPM_TAKE_PROFIT_ATR_MULT=4.0     # Take profit = 4.0 × ATR
VMPM_TRAILING_STOP_ATR_MULT=1.5   # Trailing stop = 1.5 × ATR

# ── Session Awareness ────────────────────────────────────────
VMPM_SESSION_OVERLAP_MULT=1.5     # Score multiplier during London/NY overlap
VMPM_VOLUME_MULTIPLIER=1.2        # Volume must be 1.2× average

# ── Regime Routing Weights ───────────────────────────────────
VMPM_ROUTING_STRONG_TREND_UP_WEIGHT=0.7
VMPM_ROUTING_STRONG_TREND_DOWN_WEIGHT=0.7
VMPM_ROUTING_RANGING_WEIGHT=0.6
VMPM_ROUTING_HIGH_VOLATILITY_WEIGHT=0.5

# ── Position Sizing by Regime ────────────────────────────────
VMPM_ROUTING_STRONG_TREND_SIZING_MULT=1.0
VMPM_ROUTING_RANGING_SIZING_MULT=0.8
VMPM_ROUTING_HIGH_VOLATILITY_SIZING_MULT=0.5


# ══════════════════════════════════════════════════════════════
# RISK — Conservative defaults for $10 capital
# ══════════════════════════════════════════════════════════════

TSAR_RISK_PER_TRADE_PCT=1.5       # Max 1.5% risk per trade ($0.15 on $10)
TSAR_MAX_POSITION_PCT=10.0        # Max 10% equity per position
TSAR_MAX_OPEN_POSITIONS=3         # Max 3 concurrent positions
TSAR_DAILY_LOSS_LIMIT_PCT=2.0     # Stop trading after 2% daily loss


# ══════════════════════════════════════════════════════════════
# DISABLED SERVICES (Render starter plan)
# ══════════════════════════════════════════════════════════════

TSAR_REDIS_ENABLED=false
TSAR_OLLAMA_ENABLED=false


# ══════════════════════════════════════════════════════════════
# OPTIONAL — Add if needed
# ══════════════════════════════════════════════════════════════

# Telegram alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# DeepSeek LLM fallback
# DEEPSEEK_API_KEY=

# CORS (for web dashboard)
# TSAR_CORS_ORIGINS=https://yourdomain.com

# ============================================================
# TSAR — Environment Variables
# ============================================================
# Copy to .env and fill in values. NEVER commit .env to git.
#   cp .env.example .env

# --- Exchange API Keys ---
# Binance (or other exchange) credentials for trading
EXCHANGE_API_KEY=your_binance_api_key_here
EXCHANGE_SECRET=your_binance_secret_here
# Set to 'true' for sandbox/testnet, 'false' for live trading
EXCHANGE_SANDBOX=true

# --- LLM Providers ---
# DeepSeek API key (primary LLM for analysis)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OpenAI API key (fallback / GPT-4 for complex reasoning)
OPENAI_API_KEY=your_openai_api_key_here
# NVIDIA NIM API key (for specialized models)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# --- Telegram Notifications ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Chat ID for trade notifications and alerts
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Redis ---
# Host and port (set automatically in Docker: redis:6379)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis AUTH password — change in production!
REDIS_PASSWORD=your_redis_password_here

# --- API Server ---
# API key for authenticating requests to the TSAR REST API
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TSAR_API_KEY=your_tsar_api_key_here
# API bind port (default: 8000)
TSAR_API_PORT=8000
# Comma-separated allowed CORS origins
TSAR_CORS_ORIGINS=http://localhost:3000

# --- Application ---
# Environment: development | staging | production
TSAR_ENVIRONMENT=development
# Trading mode: paper (simulated) | live (real money!)
TSAR_TRADING_MODE=paper
# Log level: DEBUG | INFO | WARNING | ERROR
TSAR_LOG_LEVEL=INFO

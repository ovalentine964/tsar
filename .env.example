# ============================================================
# TSAR CONFIGURATION — Fill in your values below
# ============================================================
# Step 1: Copy this file: cp .env.example .env
# Step 2: Fill in the values marked with "← FILL IN"
# Step 3: Run: docker-compose up -d
# ============================================================

# ── BINANCE (Required for trading) ──────────────────────────
# Get keys: https://testnet.binance.vision/ (for testing)
#            https://www.binance.com → API Management (for real)
EXCHANGE_API_KEY=← FILL IN
EXCHANGE_SECRET=← FILL IN
EXCHANGE_SANDBOX=true                    # true = testnet (safe), false = real money

# ── NVIDIA AI (Required for smart decisions) ────────────────
# Get free key: https://build.nvidia.com → Get API Key
NVIDIA_API_KEY=← FILL IN

# ── TELEGRAM (Optional — get alerts on your phone) ──────────
# 1. Message @BotFather on Telegram → /newbot → copy token
# 2. Message your bot → visit api.telegram.org/bot<TOKEN>/getUpdates → copy chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── TSAR API (For mobile app connection) ────────────────────
TSAR_API_KEY=tsar-secret-key-change-me    # Change this! Any random string
TSAR_API_PORT=8000
TSAR_TRADING_MODE=paper                    # paper = safe testing, live = real money

# ── REDIS (Auto-configured in Docker — don't change) ────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=tsar_redis_2026

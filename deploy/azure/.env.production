# ============================================================
# TSAR — Azure 24/7 Production Environment
# ============================================================
# For deployment via: ./deploy/azure/deploy-24-7.sh
#
# Copy this file and fill in your values:
#   cp deploy/azure/.env.production deploy/azure/.env.production.local
#   nano deploy/azure/.env.production.local
#
# ⚠️  NEVER commit this file with real secrets to git!
# ============================================================


# ── Exchange (Binance Testnet) ───────────────────────────────
# Get testnet keys: https://testnet.binance.vision/
EXCHANGE_API_KEY=                           # REQUIRED
EXCHANGE_SECRET=                            # REQUIRED
EXCHANGE_SANDBOX=true                       # Always true for paper trading


# ── NVIDIA AI (Required for LLM) ────────────────────────────
# Free key: https://build.nvidia.com → Get API Key
NVIDIA_API_KEY=                             # REQUIRED


# ── DeepSeek (Optional — fallback LLM) ──────────────────────
# https://platform.deepseek.com
DEEPSEEK_API_KEY=                           # Optional


# ── TSAR API Security ───────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TSAR_API_KEY=                               # REQUIRED — min 16 characters
TSAR_API_PORT=8000
TSAR_API_HOST=0.0.0.0
TSAR_TRADING_MODE=paper                     # paper only on free tier
TSAR_ENVIRONMENT=production


# ── CORS ─────────────────────────────────────────────────────
# After deployment, set to your container URL:
#   http://tsar-app.eastus.azurecontainer.io:8000
# For mobile APK: add your domain or leave empty to deny all
TSAR_CORS_ORIGINS=


# ── Database (SQLite — no Redis needed) ─────────────────────
TSAR_DATABASE_BACKEND=sqlite
TSAR_DATABASE_PATH=/app/data/tsar.db
TSAR_REDIS_ENABLED=false


# ── LLM (Cloud only — no Ollama on free tier) ───────────────
TSAR_OLLAMA_ENABLED=false


# ── Telegram Alerts (Optional but recommended) ──────────────
# Get bot token: message @BotFather on Telegram → /newbot
# Get chat ID: message your bot, then visit
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ── Azure Deployment ────────────────────────────────────────
AZURE_RESOURCE_GROUP=tsar-247-rg
AZURE_LOCATION=eastus
AZURE_DNS_LABEL=tsar-app
TSAR_IMAGE_TAG=latest


# ── Monitoring Alerts (Optional) ────────────────────────────
# Email for Azure Monitor alerts (restart, OOM, high CPU)
ALERT_EMAIL=

# Log Analytics (optional — for centralized logging)
# Create: az monitor log-analytics workspace create -g tsar-247-rg -n tsar-logs
LOG_ANALYTICS_WORKSPACE_ID=
LOG_ANALYTICS_WORKSPACE_KEY=

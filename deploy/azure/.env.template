# ============================================================
# TSAR — Azure Deployment Environment Variables
# ============================================================
# Copy this file to .env at the project root and fill in values:
#   cp deploy/azure/.env.template .env
#
# Variables marked [REQUIRED] must be set before deployment.
# Variables marked [OPTIONAL] have sensible defaults.
# ============================================================


# ── Exchange (Binance) ───────────────────────────────────────
# [REQUIRED for trading] Your Binance API credentials.
# Get testnet keys: https://testnet.binance.vision/
# Get production keys: https://www.binance.com → API Management
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
EXCHANGE_SANDBOX=true                # true = testnet (safe), false = real money


# ── NVIDIA AI ────────────────────────────────────────────────
# [REQUIRED] API key for NVIDIA AI inference (used for market analysis).
# Get free key: https://build.nvidia.com → Get API Key
NVIDIA_API_KEY=


# ── TSAR API Security ───────────────────────────────────────
# [REQUIRED] API key for authenticating client requests to TSAR.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TSAR_API_KEY=

# [REQUIRED] CORS allowed origins (comma-separated).
# Example: https://tsar-app.eastus.azurecontainer.io,https://yourdomain.com
# Leave empty to deny all cross-origin requests.
TSAR_CORS_ORIGINS=


# ── Redis ────────────────────────────────────────────────────
# [REQUIRED] Password for Redis authentication.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# In Azure ACI, Redis runs as a sidecar on localhost.
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379


# ── TSAR Application ────────────────────────────────────────
# [OPTIONAL] Trading mode: "paper" (default, safe) or "live" (real money).
TSAR_TRADING_MODE=paper

# [OPTIONAL] API server port. Default: 8000.
TSAR_API_PORT=8000

# [OPTIONAL] Environment label.
TSAR_ENVIRONMENT=production


# ── Telegram Alerts ─────────────────────────────────────────
# [OPTIONAL] Telegram bot for trade alerts and notifications.
# 1. Message @BotFather → /newbot → copy token
# 2. Message your bot → visit api.telegram.org/bot<TOKEN>/getUpdates → copy chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ── Azure Deployment (used by deploy-azure.sh) ──────────────
# [OPTIONAL] Docker image tag to deploy. Default: latest.
TSAR_IMAGE_TAG=latest

# [OPTIONAL] Azure Container Registry (ACR) credentials.
# If set, the script pulls from ACR instead of Docker Hub.
TSAR_ACR_SERVER=                   # e.g., tsarregistry.azurecr.io
TSAR_ACR_USERNAME=                 # ACR username
TSAR_ACR_PASSWORD=                 # ACR password or service principal


# ── TLS (Optional — HTTPS) ──────────────────────────────────
# For Azure, use Azure Application Gateway or Front Door for TLS termination.
# Or mount certs and set these paths:
TSAR_SSL_CERTFILE=                      # [OPTIONAL] TLS certificate file path
TSAR_SSL_KEYFILE=                       # [OPTIONAL] TLS private key file path


# ── Azure Monitor (used by monitoring.sh) ────────────────────
# [OPTIONAL] Log Analytics workspace for centralized logging.
# Create one: az monitor log-analytics workspace create -g tsar-rg -n tsar-logs
LOG_ANALYTICS_WORKSPACE_ID=
LOG_ANALYTICS_WORKSPACE_KEY=

# [OPTIONAL] Email for alert notifications.
ALERT_EMAIL=
